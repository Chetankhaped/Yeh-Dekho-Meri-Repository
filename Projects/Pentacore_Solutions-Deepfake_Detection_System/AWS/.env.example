# AWS & Cognito environment (used by detection_engine service)
# Copy this file to AWS/.env and set the values below. Do NOT commit real secrets.

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=deepfake-analyzer-tool
# Enable S3-only storage by default
S3_ENABLED=true
S3_PREFIX=dev

# Cognito (optional)
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_aVY3cwwvu
COGNITO_USER_POOL_CLIENT_ID=25ftc6u67t609hpphvqgirmd

# Notes:
# - When running on EC2 from the CloudFormation stack, the instance profile is used and these keys can remain blank.
# - For local development, provide temporary credentials with access to the bucket/prefix.
