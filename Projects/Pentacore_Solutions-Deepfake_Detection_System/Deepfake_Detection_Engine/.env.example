# Backend configuration (.env)
# Adjust paths and limits without code changes

# Absolute or relative path to the model file
MODEL_PATH=model/best_pinpoint_model_antisocial.pth

# Root folder to persist per-user artifacts (JSON + images + optional media copies)
USER_DATA_ROOT=user_data

# Maximum upload size in megabytes (enforced at API level)
MAX_UPLOAD_MB=200

# Uvicorn server settings (optional)
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins, or * for all)
# When using docker-compose in this repo, the website runs on 8080 by default
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
