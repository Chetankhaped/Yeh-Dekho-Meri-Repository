# Host port mappings on the EC2 host
# Typically, Website served on 80 (or behind ALB 80/443); Engine/Credits stay internal
WEBSITE_HOST_PORT=80
ENGINE_HOST_PORT=8001
CREDITS_HOST_PORT=8003

## Feature flags
# Enable credits and enforce JWT in production (optional)
CREDITS_ENABLED=true
COGNITO_ENFORCE=true

## Engine settings
MAX_UPLOAD_MB=400
# If you route via ALB path /engine, set
# BASE_PATH_PREFIX=/engine
BASE_PATH_PREFIX=

# Allow the public site origin (replace with your domain)
ALLOWED_ORIGINS=https://your-domain.example

## Website runtime config for cloud routing
# If you front with an ALB + domain and an API Gateway for engine GETs:
# ENGINE_BASE_URL should be your API Gateway invoke URL (e.g., https://abc123.execute-api.ap-south-1.amazonaws.com/v1)
# ENGINE_UPLOAD_BASE_URL should be your public domain path routed by ALB (e.g., https://deepfake-analyzer-tool.example.com/engine)
# CREDITS_BASE_URL should be your public domain path routed by ALB (e.g., https://deepfake-analyzer-tool.example.com/credits)
ENGINE_BASE_URL=
ENGINE_UPLOAD_BASE_URL=
CREDITS_BASE_URL=

## Website OIDC (Cognito) — required to enable login
# COGNITO_AUTHORITY format: https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
COGNITO_AUTHORITY=
COGNITO_CLIENT_ID=
COGNITO_LOGOUT_DOMAIN=
OIDC_REDIRECT_PATH=/index.html
