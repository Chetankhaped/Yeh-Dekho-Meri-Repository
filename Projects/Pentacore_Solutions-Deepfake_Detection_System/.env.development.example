# Host port mappings for local dev
WEBSITE_HOST_PORT=8080
ENGINE_HOST_PORT=8001
CREDITS_HOST_PORT=8003

# Feature flags (local mode: no enforced JWT; credits optional)
CREDITS_ENABLED=false
COGNITO_ENFORCE=false

# Engine settings
MAX_UPLOAD_MB=400
BASE_PATH_PREFIX=

# CORS for local website (origins allowed by the engine)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost,http://127.0.0.1

# Website runtime config overrides (optional)
# These are used to generate runtime-config.json inside the website container
ENGINE_BASE_URL=http://localhost:8001
ENGINE_UPLOAD_BASE_URL=http://localhost:8001
CREDITS_BASE_URL=http://localhost:8003

# Website OIDC (optional for local dev). Leave empty to disable login.
COGNITO_AUTHORITY=
COGNITO_CLIENT_ID=
COGNITO_LOGOUT_DOMAIN=
OIDC_REDIRECT_PATH=/index.html
